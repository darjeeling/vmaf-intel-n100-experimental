+static void release_imported_avframe(void *cookie)
+{
+    AVFrame *frame = cookie;
+    av_frame_free(&frame);
+}
+
+static int wrap_picture_data(AVFrame *src, VmafPicture *dst, unsigned bpc)
+{
+    VmafPictureImportConfiguration cfg = {
+        .pix_fmt = VMAF_PIX_FMT_YUV420P,
+        .bpc = bpc,
+        .w = src->width,
+        .h = src->height,
+        .release = release_imported_avframe,
+    };
+    /* This experiment audits only v1 CPU extractors at this frame shape.
+     * Other shapes, formats, unaligned and non-refcounted inputs fall back.
+     * No hardware surface is imported: the input is already planar host YUV. */
+    if (src->width != 1920 || src->height != 1080 ||
+        (src->format != AV_PIX_FMT_YUV420P &&
+         src->format != AV_PIX_FMT_YUV420P10LE) || !src->buf[0])
+        return AVERROR(ENOSYS);
+
+    for (unsigned i = 0; i < 3; i++) {
+        AVBufferRef *buf = av_frame_get_plane_buffer(src, i);
+        uintptr_t start, data;
+        size_t offset;
+        if (!buf || !src->data[i] || src->linesize[i] <= 0)
+            return AVERROR(EINVAL);
+        start = (uintptr_t)buf->data;
+        data = (uintptr_t)src->data[i];
+        if (data < start || data - start > buf->size)
+            return AVERROR(EINVAL);
+        offset = data - start;
+        cfg.data[i] = src->data[i];
+        cfg.stride[i] = src->linesize[i];
+        cfg.data_size[i] = buf->size - offset;
+    }
+
+    /* av_frame_clone retains AVBufferRefs without copying pixel storage. */
+    AVFrame *owned = av_frame_clone(src);
+    if (!owned) return AVERROR(ENOMEM);
+    cfg.cookie = owned;
+    int err = vmaf_picture_import(dst, &cfg);
+    if (err)
+        av_frame_free(&owned); /* Import failure did not take ownership. */
+    return err;
+}
