+int vmaf_picture_import(VmafPicture *pic,
+                        const VmafPictureImportConfiguration *cfg)
+{
+    VmafPicture imported = { 0 };
+    if (!pic || !cfg || !cfg->release ||
+        cfg->pix_fmt != VMAF_PIX_FMT_YUV420P ||
+        (cfg->bpc != 8 && cfg->bpc != 10) ||
+        cfg->w < 2 || cfg->h < 2 || (cfg->w & 1) || (cfg->h & 1) ||
+        cfg->w > INT_MAX || cfg->h > INT_MAX)
+        return -EINVAL;
+
+    const unsigned bytes = cfg->bpc > 8 ? 2 : 1;
+    imported.pix_fmt = cfg->pix_fmt;
+    imported.bpc = cfg->bpc;
+    for (unsigned i = 0; i < 3; i++) {
+        const unsigned w = cfg->w >> !!i;
+        const unsigned h = cfg->h >> !!i;
+        if (!cfg->data[i] || ((uintptr_t)cfg->data[i] % DATA_ALIGN) ||
+            cfg->stride[i] <= 0 || cfg->stride[i] > INT_MAX ||
+            cfg->stride[i] % DATA_ALIGN ||
+            (size_t)w > SIZE_MAX / bytes ||
+            (size_t)cfg->stride[i] < (size_t)w * bytes ||
+            (size_t)cfg->stride[i] > (SIZE_MAX - 64) / h ||
+            cfg->data_size[i] < (size_t)cfg->stride[i] * h + 64)
+            return -EINVAL;
+        imported.w[i] = w;
+        imported.h[i] = h;
+        imported.data[i] = cfg->data[i];
+        imported.stride[i] = cfg->stride[i];
+    }
+
+    int err = vmaf_picture_priv_init(&imported);
+    if (err) return -ENOMEM;
+    err = vmaf_ref_init(&imported.ref);
+    if (err) {
+        free(imported.priv);
+        return err;
+    }
+    VmafPicturePrivate *priv = imported.priv;
+    priv->cookie = cfg->cookie;
+    priv->release_picture = release_imported_picture;
+    priv->release_import = cfg->release;
+    priv->buf_type = VMAF_PICTURE_BUFFER_TYPE_HOST;
+    *pic = imported;
+    return 0;
+}
