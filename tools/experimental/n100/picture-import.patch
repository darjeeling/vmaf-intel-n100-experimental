+static char *test_decimate_10b_different_strides()
+{
+    /* Input has more padding than output: the old bulk memcpy overran output.
+     * Reversing them checks short source stride without row mixing. */
+    for (unsigned reverse = 0; reverse < 2; reverse++) {
+        const unsigned w = 64, h = 12;
+        const size_t src_stride = reverse ? 128 : 192;
+        const size_t dst_stride = reverse ? 192 : 128;
+        uint8_t *src = aligned_malloc(src_stride * h, 32);
+        uint8_t *dst = aligned_malloc(dst_stride * h, 32);
+        mu_assert("padding test allocation failed", src && dst);
+        memset(src, 0xEE, src_stride * h);
+        memset(dst, 0xA5, dst_stride * h);
+        for (unsigned y = 0; y < h; y++)
+            for (unsigned x = 0; x < w; x++)
+                ((uint16_t *)(src + y * src_stride))[x] = (y * 67 + x) & 1023;
+        VmafPicture in = { .bpc = 10, .w = {w}, .h = {h},
+                           .stride = {src_stride}, .data = {src} };
+        VmafPicture out = { .bpc = 10, .w = {w}, .h = {h},
+                            .stride = {dst_stride}, .data = {dst} };
+        decimate_generic_uint16_and_convert_to_10b(&in, &out, w, h);
+        for (unsigned y = 0; y < h; y++) {
+            mu_assert("different-stride copy changed logical pixels",
+                      !memcmp(src + y * src_stride, dst + y * dst_stride, w * 2));
+            for (size_t x = w * 2; x < dst_stride; x++)
+                mu_assert("different-stride copy touched destination padding",
+                          dst[y * dst_stride + x] == 0xA5);
+        }
+        aligned_free(src);
+        aligned_free(dst);
+    }
+    return NULL;
+}
