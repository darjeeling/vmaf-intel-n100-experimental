+/* Keep the existing 9-tap AVX/FMA instructions and boundary arithmetic, but
+ * compute only rows that vif_dec16_s would retain.  Horizontal scanlines
+ * still compute all columns to preserve the existing implementation exactly.
+ * Future selected source rows start at 16 * (out_y + 1) - 4, so compact
+ * in-place output row out_y cannot overwrite an input needed by a later row.
+ */
+void convolution_f32_avx_s_dec16(const float *filter, const float *src,
+                               float *dst, float *row, float *tmp,
+                               int width, int height, int src_stride,
+                               int dst_stride)
+{
+    const int filter_width = 9;
+    const int radius = filter_width / 2;
+    const int width_floor_step = vmaf_floorn(width, AVX_STEP);
+    const int tmp_stride = vmaf_ceiln(width, AVX_STEP);
+    const int j_vec_end = vmaf_floorn(width - radius, AVX_STEP);
+
+    for (int out_y = 0; out_y < height / 16; out_y++) {
+        const int y = out_y * 16;
+        if (y < radius || y >= height - radius) {
+            for (int x = 0; x < width; x++)
+                tmp[x] = convolution_edge_s(false, filter, filter_width,
+                    src, width, height, src_stride, y, x);
+        } else {
+            convolution_f32_avx_s_1d_v_scanline(filter, filter_width,
+                src + y * src_stride, tmp, src_stride, width_floor_step);
+            for (int x = width_floor_step; x < width; x++)
+                tmp[x] = convolution_edge_s(false, filter, filter_width,
+                    src, width, height, src_stride, y, x);
+        }
+
+        for (int x = 0; x < radius; x++)
+            row[x] = convolution_edge_s(true, filter, filter_width,
+                tmp, width, 1, tmp_stride, 0, x);
+        convolution_f32_avx_s_1d_h_scanline(filter, filter_width,
+            tmp, row, j_vec_end);
+        for (int x = j_vec_end; x < width; x++)
+            row[x] = convolution_edge_s(true, filter, filter_width,
+                tmp, width, 1, tmp_stride, 0, x);
+
+        for (int out_x = 0; out_x < width / 16; out_x++)
+            dst[out_y * dst_stride + out_x] = row[out_x * 16];
+    }
+}
